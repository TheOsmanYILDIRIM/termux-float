<?xml version="1.0" encoding="utf-8"?>
<!-- Glass Header Background with rounded top corners -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="@dimen/glass_window_corner_radius"
        android:topRightRadius="@dimen/glass_window_corner_radius"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
    <gradient
        android:angle="270"
        android:startColor="#40FFFFFF"
        android:centerColor="#20FFFFFF"
        android:endColor="#10FFFFFF"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#25FFFFFF" />
</shape>
